; Production MD Simulation
; Generated by prepare_evaporation.py

title                   = Production MD Simulation

; Run parameters
integrator              = md            ; Leap-frog integrator
nsteps                  = 5000000      ; 5.0 ns
dt                      = 0.001          ; 1.0 fs

; Output control
nstxout                 = 100000    ; Save coordinates to .trr every 100000 steps
nstvout                 = 100000    ; Save velocities to .trr every 100000 steps
nstenergy               = 100000    ; Save energies every 100000 steps
nstlog                  = 100000    ; Update log every 100000 steps
nstxout-compressed      = 100000    ; Save compressed coords every 100000 steps

; Bond parameters
continuation            = yes           ; Continuing from NPT
constraint_algorithm    = lincs         ; Holonomic constraints
constraints             = h-bonds       ; Constrain H-bonds
lincs_iter              = 2             ; Accuracy of LINCS
lincs_order             = 4             ; Also related to accuracy

; Neighbor searching and VdW
cutoff-scheme           = Verlet
ns_type                 = grid          ; Search neighboring grid cells
nstlist                 = 20            ; Largely irrelevant with Verlet
rlist                   = 1.2
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2        ; VdW cutoff (nm)

; Electrostatics
coulombtype             = PME           ; Particle Mesh Ewald
rcoulomb                = 1.2    ; Coulomb cutoff (nm)
pme_order               = 4             ; Cubic interpolation
fourierspacing          = 0.16          ; Grid spacing for FFT

; Temperature coupling
tcoupl                  = V-rescale     ; Modified Berendsen thermostat
tc-grps                 = System
tau_t                   = 1.0           ; Time constant (ps)
ref_t                   = 313.0        ; Reference temperature (K)

; Pressure coupling
pcoupl                  = C-rescale     ; Pressure coupling on
pcoupltype              = semiisotropic ; Semiisotropic scaling
tau_p                   = 5.0           ; Time constant (ps)
ref_p                   = 0.0 1.0 ; Reference pressure (bar)
compressibility         = 0.0 4.5e-5    ; Isothermal compressibility

; Periodic boundary conditions
pbc                     = xyz           ; 3-D PBC

; Dispersion correction
DispCorr                = no

; Velocity generation
gen_vel                 = no            ; Continue from NPT
